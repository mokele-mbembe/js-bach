{
  "name": "js-bach",
  "version": "0.1.4",
  "description": "Local browser player for J.S. Bach’s Well-Tempered Clavier",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/mokele-mbembe/js-bach.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:corpus": "npm run build && node dist/scripts/build-corpus.js",
    "audit:sources": "npm run build && node dist/scripts/audit-sources.js",
    "audit:voices": "npm run build && node dist/scripts/audit-voices.js",
    "check:corpus": "npm run build && node dist/scripts/check-corpus.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "verify": "npm test && node dist/scripts/build-corpus.js --fresh",
    "verify:cached": "npm test && node dist/scripts/build-corpus.js --cache-dir dist/transposition-cache",
    "demo": "npm run build:corpus && node dist/scripts/serve-demo.js",
    "demo:serve": "npm run build && node dist/scripts/serve-demo.js",
    "build:pages": "npm run build:corpus && npm run build:pages:built",
    "build:pages:built": "node dist/scripts/build-pages.js",
    "test:pages": "node dist/scripts/check-pages.js",
    "pack:preview": "npm run build:corpus && npm run pack:preview:built",
    "pack:preview:built": "node dist/scripts/pack-preview.js",
    "report:preview": "node dist/scripts/report-preview.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "csv-parse": "^7.0.3",
    "midi-file": "^1.2.4",
    "playwright": "^1.65.1",
    "typescript": "~5.9.3"
  }
}
